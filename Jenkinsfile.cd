pipeline {
  agent {
    kubernetes {
      defaultContainer 'helm'
      yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: weasley-cd-agent
spec:
  serviceAccountName: jenkins
  securityContext:
    runAsNonRoot: true
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: helm
      image: alpine/helm:3.16.1
      command: ['cat']
      tty: true
'''
    }
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Image tag to deploy. Empty uses latest successful CI BUILD_NUMBER if passed by upstream job.')
    string(name: 'REGISTRY_HOST', defaultValue: 'local-registry.registry.svc.cluster.local:5000', description: 'In-cluster Docker registry host:port')
    string(name: 'HELM_RELEASE', defaultValue: 'weasley-clock', description: 'Helm release name')
    string(name: 'HELM_NAMESPACE', defaultValue: 'weasley', description: 'Kubernetes namespace to deploy into')
    string(name: 'INGRESS_HOST', defaultValue: 'weasley.example.com', description: 'Public host for ingress')
    string(name: 'INGRESS_CLASS', defaultValue: 'nginx', description: 'Ingress class (nginx or alb)')
    string(name: 'TLS_SECRET_NAME', defaultValue: 'weasley-tls', description: 'TLS secret name for ingress')
    booleanParam(name: 'WAIT_FOR_ROLLOUT', defaultValue: true, description: 'Wait for deployment rollout before success')
  }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    EFFECTIVE_TAG = "${params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : env.BUILD_NUMBER}"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Deploy With Helm') {
      steps {
        container('helm') {
          sh '''
            set -eu

            echo "Deploying tag: ${EFFECTIVE_TAG}"
            echo "Registry: ${REGISTRY_HOST}"

            helm upgrade --install "${HELM_RELEASE}" ./helm \
              --namespace "${HELM_NAMESPACE}" \
              --create-namespace \
              --set imageRegistry="${REGISTRY_HOST}" \
              --set imageTag="${EFFECTIVE_TAG}" \
              --set ingress.enabled=true \
              --set ingress.className="${INGRESS_CLASS}" \
              --set ingress.host="${INGRESS_HOST}" \
              --set ingress.tlsSecretName="${TLS_SECRET_NAME}" \
              --atomic \
              --timeout 10m
          '''
        }
      }
    }

    stage('Verify Release') {
      when {
        expression { return params.WAIT_FOR_ROLLOUT }
      }
      steps {
        container('helm') {
          sh '''
            set -eu
            helm status "${HELM_RELEASE}" --namespace "${HELM_NAMESPACE}"
          '''
        }
      }
    }
  }

  post {
    success {
      echo "CD complete: ${HELM_RELEASE} deployed to ${HELM_NAMESPACE} using ${REGISTRY_HOST}/weasley-*: ${EFFECTIVE_TAG}"
    }
    failure {
      echo 'CD failed. Check helm output above.'
    }
  }
}
